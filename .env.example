# ───────────────────────────── Runtime ─────────────────────────────
NODE_ENV=development

# Demo workspace. Development uses owner@acme.test / SetraDemo!2026 by default. For an explicitly
# enabled production demo, set DEMO_SEED_ENABLED=true and provide a unique password of 14+ chars.
DEMO_SEED_ENABLED=false
DEMO_OWNER_EMAIL=owner@acme.test
DEMO_OWNER_PASSWORD=
# Origin of the web console. Used for CORS/CSRF checks and cookie scoping.
WEB_ORIGIN=http://localhost:3000
# Public base URL used in hosted payment links (defaults to WEB_ORIGIN).
PUBLIC_APP_URL=http://localhost:3000
API_PORT=4000
# Where the Next.js server proxies /api/* (server-side only, never exposed to the browser).
API_INTERNAL_URL=http://localhost:4000
LOG_LEVEL=info

# ───────────────────────────── Database ─────────────────────────────
# The application connects as setra_app, a NON-superuser role, so row-level security is enforced.
DATABASE_URL=postgresql://setra_app:setra_app@localhost:5432/setra
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgresql://setra:setra@localhost:5432/setra
# Integration tests use a separate database (created by docker/init). They reset it on every run.
TEST_DATABASE_URL=postgresql://setra_app:setra_app@localhost:5432/setra_test
TEST_MIGRATION_DATABASE_URL=postgresql://setra:setra@localhost:5432/setra_test
DB_POOL_SIZE=10

# ───────────────────────────── Secrets ─────────────────────────────
# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# AES-256-GCM key for webhook signing secrets. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# ───────────────────────────── Monad (primary) ─────────────────────────────
# Live mode → Monad mainnet (chain 143). Use an authenticated provider in production.
MONAD_ENABLED=true
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_WS_URL=
# Max blocks per eth_getLogs call for your provider (public QuickNode endpoint: 100).
MONAD_LOGS_BLOCK_RANGE=100
# Canonical USDC / USDT0 are built in; override only if you know why.
MONAD_USDC_ADDRESS=
MONAD_USDT0_ADDRESS=
# Setra Payment Intent contract (optional; direct transfers work without it).
MONAD_PAYMENT_INTENT_ADDRESS=
MONAD_PAYMENT_INTENT_DEPLOY_BLOCK=

# Test mode → Monad testnet (chain 10143). Testnet USDC is Circle's 0x534b…43A3 (faucet.circle.com).
MONAD_TESTNET_ENABLED=true
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_WS_URL=
MONAD_TESTNET_LOGS_BLOCK_RANGE=100
MONAD_TESTNET_USDC_ADDRESS=
MONAD_TESTNET_PAYMENT_INTENT_ADDRESS=
MONAD_TESTNET_PAYMENT_INTENT_DEPLOY_BLOCK=

# ───────────────────────────── Base (secondary, off by default) ─────────────────────────────
BASE_ENABLED=false
BASE_RPC_URL=https://mainnet.base.org
BASE_CONFIRMATIONS=12
BASE_PAYMENT_INTENT_ADDRESS=
BASE_SEPOLIA_ENABLED=false
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CONFIRMATIONS=6
BASE_SEPOLIA_PAYMENT_INTENT_ADDRESS=

# ───────────────────────────── Local devnet (automated tests) ─────────────────────────────
# `npm run local-chain` starts Anvil, deploys a mock USDC and the intent contract, and prints these.
LOCAL_CHAIN_ENABLED=false
LOCAL_CHAIN_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337
LOCAL_USDC_ADDRESS=
LOCAL_PAYMENT_INTENT_ADDRESS=

# ───────────────────────────── Worker ─────────────────────────────
WORKER_POLL_MS=1000
# When a wallet starts being monitored, also scan this many recent blocks (Monad: ~10 minutes).
WORKER_BACKFILL_SAFETY_BLOCKS=1500
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_TIMEOUT_MS=10000
# Allow webhook URLs on localhost/private networks. Defaults to true outside production.
WEBHOOK_ALLOW_PRIVATE_URLS=

# ───────────────────────────── API ─────────────────────────────
RATE_LIMIT_PER_MINUTE=300
# Proxy hops allowed to set X-Forwarded-For (proxy-addr syntax, or true/false). The default trusts only
# private/loopback peers such as the Next.js proxy, so clients can't spoof their IP to dodge rate limits.
TRUST_PROXY=loopback,linklocal,uniquelocal
AUTH_RATE_LIMIT_PER_MINUTE=20

# ───────────────────────────── Email (optional) ─────────────────────────────
# Without SMTP, password-reset and invitation links are written to the API log (development only).
# Optional: shared secret for the Monad execution-events sidecar (services/execution-events).
EXEC_EVENTS_INGEST_TOKEN=
SMTP_URL=
EMAIL_FROM=Setra <no-reply@example.com>

# ── Optional integrations ───────────────────────────────────────────────────────────────────────
# Counterparty lookups (Nansen): public labels for the senders of unidentified payments. Server only.
NANSEN_API_KEY=
# Pay with email on the payment page (Dynamic embedded wallets). Public environment ID, not a secret.
# In the Dynamic dashboard: enable email sign-in and embedded wallets, add Monad (and Monad testnet),
# and allow http://localhost:3000 as an origin.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# Envio HyperSync (faster wallet history import). Server only.
ENVIO_API_TOKEN=
