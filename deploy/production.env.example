# Copy to deploy/production.env and fill in. Keep the real file in your secret store; it is gitignored.
NODE_ENV=production
DEMO_SEED_ENABLED=false
DEMO_OWNER_EMAIL=owner@acme.test
DEMO_OWNER_PASSWORD=
LOG_LEVEL=info

# Public origins (HTTPS). WEB_ORIGIN is checked for CSRF; PUBLIC_APP_URL builds payment links.
WEB_ORIGIN=https://app.example.com
PUBLIC_APP_URL=https://app.example.com
API_PORT=4000
# Hops in front of the API whose X-Forwarded-For is trusted (rate limits and audit IPs).
TRUST_PROXY=loopback,linklocal,uniquelocal

# Database. Managed Postgres: point both URLs at it (owner for migrations, setra_app for the app).
# Bundled database (--profile bundled-db): host is "postgres".
POSTGRES_PASSWORD=
SETRA_APP_PASSWORD=
DATABASE_URL=postgresql://setra_app:<SETRA_APP_PASSWORD>@postgres:5432/setra
MIGRATION_DATABASE_URL=postgresql://setra:<POSTGRES_PASSWORD>@postgres:5432/setra
DB_POOL_SIZE=10

# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -hex 32  (losing it invalidates stored webhook secrets)
ENCRYPTION_KEY=

# Monad. Use an authenticated RPC provider in production and set the range to its eth_getLogs limit.
MONAD_ENABLED=true
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_LOGS_BLOCK_RANGE=100
MONAD_PAYMENT_INTENT_ADDRESS=
MONAD_PAYMENT_INTENT_DEPLOY_BLOCK=
MONAD_TESTNET_ENABLED=true
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_LOGS_BLOCK_RANGE=100
MONAD_TESTNET_PAYMENT_INTENT_ADDRESS=
MONAD_TESTNET_PAYMENT_INTENT_DEPLOY_BLOCK=

# Optional: Monad execution events sidecar (openssl rand -hex 24). Unset disables the ingest endpoint.
EXEC_EVENTS_INGEST_TOKEN=

# Worker and webhooks
WORKER_POLL_MS=1000
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_TIMEOUT_MS=10000

# Email (password reset, invitations). Without SMTP nothing is sent.
SMTP_URL=
EMAIL_FROM=Setra <no-reply@example.com>
